# Cloudflare Pages/Workers 배포 시 대시보드 > Settings > Variables 에 설정
NEXT_PUBLIC_SITE_URL=https://cardory.cc
# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX) — 미설정 시 GA 비활성
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# 선택 (미설정 시 기본값 사용)
EXCHANGE_RATE_API_KEY=
POKEMON_TCG_API_KEY=

# 커뮤니티 공지 작성 (관리자 전용) — web/.env.local 및 Cloudflare Variables
COMMUNITY_ADMIN_TOKEN=
COMMUNITY_ADMIN_NAME=운영자
